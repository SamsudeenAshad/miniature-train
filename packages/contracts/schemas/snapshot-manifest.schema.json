{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SnapshotManifest",
  "type": "object",
  "required": ["source", "schema_version", "content_digest", "split_manifest_digest",
               "row_count", "series", "validation_status", "immutable"],
  "properties": {
    "source": {"type": "string"},
    "schema_version": {"type": "string"},
    "content_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "split_manifest_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "row_count": {"type": "integer", "minimum": 1},
    "series": {"type": "array", "items": {"type": "string"}},
    "validation_status": {"type": "string", "enum": ["accepted", "quarantined"]},
    "immutable": {"type": "boolean", "const": true}
  }
}
